# Database
DATABASE_URL="postgresql://chess_app:chess_app@localhost:5432/chess_app"

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-secret-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# S3-compatible storage (local: MinIO)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="auto"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="chess-app"

# SMTP (local: use Mailpit or similar)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER="user"
SMTP_PASS="pass"

# App (local dev only — production APP_VERSION is the deploy commit SHA)
APP_VERSION="dev"
