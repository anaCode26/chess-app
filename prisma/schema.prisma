generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String?
  status       UserStatus @default(PENDING)
  roleId       String
  role         Role       @relation("UserRole", fields: [roleId], references: [id])
  /// Opt-out for the announcement sent when an event is published.
  notifyOnNewEvent Boolean @default(true)
  modifiedByUserId String?
  modifiedByUser   User?   @relation("UserModifiedBy", fields: [modifiedByUserId], references: [id], onDelete: SetNull)
  modifiedUsers    User[]  @relation("UserModifiedBy")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  modifiedEvents    Event[]            @relation("EventModifiedBy")
  modifiedRoles     Role[]             @relation("RoleModifiedBy")
  verificationCodes VerificationCode[]
}

/// What a user may do is a row, not a value in the code. Adding a role is a
/// backoffice action; adding a *module* means editing `lib/constants/modules.ts`.
model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  /// Seeded roles the backoffice may not rename or delete.
  isSystem    Boolean @default(false)
  /// The role self-service registration assigns. At most one row is true;
  /// the repository clears the previous flag when a new one is set.
  isDefault   Boolean @default(false)

  permissions Permission[]
  users       User[]       @relation("UserRole")

  modifiedByUserId String?
  modifiedByUser   User?   @relation("RoleModifiedBy", fields: [modifiedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per (role, module). A module with no row is denied, so absence and
/// `false` mean the same thing and nothing has to backfill on a new module.
model Permission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  /// A `ModuleKey` from `lib/constants/modules.ts`.
  module   String
  canRead  Boolean @default(false)
  canWrite Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, module])
}

model Event {
  id    String   @id @default(cuid())
  /// Authored in one language and rendered as-is in every locale.
  title String
  /// First club night of the series. A single-night event has no `endDate`.
  date  DateTime @db.Date
  /// Last club night of the series. Null means the event is only `date`.
  endDate DateTime? @db.Date
  /// ISO dates (`YYYY-MM-DD`) for club nights inside the range that do not run.
  skippedDates String[] @default([])
  /// Display string in the club's own notation ("19.00"), not a parsed time.
  startTime   String?
  description String?
  published   Boolean @default(false)
  /// Stamped when members were notified. Null means never announced, and the
  /// claim that sets it is what makes the announcement fire exactly once.
  announcedAt DateTime?

  modifiedByUserId String?
  modifiedByUser   User?   @relation("EventModifiedBy", fields: [modifiedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// A short-lived code emailed to prove the address. The plaintext is never stored.
model VerificationCode {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   VerificationPurpose
  codeHash  String
  expiresAt DateTime
  attempts  Int                 @default(0)
  consumed  Boolean             @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, purpose, consumed])
}

/// Link emailed when an officer creates an account. The user sets a password
/// before the account becomes active. One live token per address.
model UserInvitationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}
